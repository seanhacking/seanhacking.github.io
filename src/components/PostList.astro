---
import { formatDate, slugify, type Post } from "../lib/content";
import { url } from "../lib/url";

interface Props { posts: Post[] }
const { posts } = Astro.props;
---
{posts.length === 0 ? (
  <p class="empty">No posts yet.</p>
) : (
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <h3><a href={url(`/blog/${post.id}/`)}>{post.data.title}</a>{post.data.draft && <span class="meta"> (draft)</span>}</h3>
        <p class="meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
        <p>{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {post.data.tags.map((t) => <li><a class="tag" href={url(`/blog/tags/${slugify(t)}/`)}>{t}</a></li>)}
          </ul>
        )}
      </li>
    ))}
  </ul>
)}
