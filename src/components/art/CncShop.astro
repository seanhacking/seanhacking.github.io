---
// Form Robotics: stock held in a workholding bed, an end mill tracing a pocket toolpath (plan view),
// with the spindle in elevation beside it.
interface Props { label?: string }
const { label = "Drawing of a CNC job in plan view: a block of stock held in a workholding bed while an end mill traces a pocket toolpath." } = Astro.props;

// Contour pocket: nested rounded rectangles stepping inwards, joined into one path.
const cx = 140, cy = 140;
let tool = "";
const loops = [[86, 62], [70, 48], [54, 34], [38, 20], [22, 8]] as const;
loops.forEach(([hw, hh], i) => {
  const r = Math.min(10, hh);
  const x0 = cx - hw, x1 = cx + hw, y0 = cy - hh, y1 = cy + hh;
  tool += `${i === 0 ? "M" : "L"}${x0 + r} ${y0}H${x1 - r}A${r} ${r} 0 0 1 ${x1} ${y0 + r}V${y1 - r}A${r} ${r} 0 0 1 ${x1 - r} ${y1}H${x0 + r}A${r} ${r} 0 0 1 ${x0} ${y1 - r}V${y0 + r}A${r} ${r} 0 0 1 ${x0 + r} ${y0}`;
});
// 45-degree hatch lines clipped to the bed rectangle (x 24..256, y 34..246).
const BX0 = 24, BX1 = 256, BY0 = 34, BY1 = 246;
let hatch = "";
for (let c = BX0 + BY0 + 10; c < BX1 + BY1; c += 11) {
  // points on x + y = c inside the rectangle
  const xa = Math.max(BX0, c - BY1), xb = Math.min(BX1, c - BY0);
  if (xb - xa > 1) hatch += `M${xa} ${c - xa}L${xb} ${c - xb}`;
}
---
<svg class="art cn" viewBox="0 0 400 280" width="400" height="280" role="img" aria-label={label}>
  <!-- workholding bed (plan) -->
  <rect class="part draw" pathLength="1" style="--t:.8s" x="24" y="34" width="232" height="212" rx="6" />
  <g class="cn-bed fade" style="--d:.5s">
    <path class="hatch" d={hatch} />
  </g>
  <rect class="part draw" pathLength="1" style="--d:.4s;--t:.7s" x="44" y="68" width="192" height="144" rx="3" />
  <path class="cl fade" style="--d:.7s" d={`M${cx - 110} ${cy}H${cx + 110}M${cx} ${cy - 86}V${cy + 86}`} />

  <!-- toolpath, drawn as the end mill cuts -->
  <path class="cn-ghost" d={tool} />
  <path class="cn-path" pathLength="1" d={tool} />
  <g class="cn-tool" style={`offset-path: path('${tool}')`}>
    <circle class="cn-cutter" r="8" />
    <path class="cn-flutes" d="M-5 -5L5 5M5 -5L-5 5" />
  </g>

  <!-- spindle, elevation -->
  <g class="cn-spindle">
    <rect class="part solid" x="300" y="34" width="44" height="70" rx="4" />
    <rect class="part" x="312" y="104" width="20" height="18" />
    <g class="cn-mill">
      <rect class="part" x="317" y="122" width="10" height="40" />
      <path class="cn-flute-side" d="M317 128l10 6M317 138l10 6M317 148l10 6" />
    </g>
  </g>
  <rect class="part part-fill" x="282" y="168" width="80" height="34" />
  <path class="hatch" d="M286 202l-8 8M302 202l-8 8M318 202l-8 8M334 202l-8 8M350 202l-8 8M366 202l-8 8" />
  <path class="ground" d="M272 202H372" />
  <text x="322" y="226" class="t-mono t-small" text-anchor="middle">ELEVATION</text>
  <text x="140" y="264" class="t-mono t-small" text-anchor="middle">PLAN · POCKET TOOLPATH</text>
  <text x="392" y="262" class="t-hand fade" style="--d:1s" text-anchor="end">LavaLock workholding</text>
  <path class="sk draw" pathLength="1" style="--d:1.1s;--t:.3s" d="M262 250C258 246 256 244 250 238" />
</svg>
