---
// Zipline Dropbox (illustration only, not the real design): a drone arrives, lowers the package
// pod into the kiosk, takes the load and leaves.
interface Props { label?: string; tally?: boolean }
const { label = "Illustration of a drone delivery kiosk: a drone hovers over the kiosk and lowers a package pod into it on a tether, then flies off. Not the actual design.", tally = true } = Astro.props;
const KX = 250; // kiosk centre line
---
<svg class="art dk" viewBox="0 0 400 280" width="400" height="280" role="img" aria-label={label}>
  <!-- ground and kiosk -->
  <path class="ground" d="M20 236H380" />
  <path class="hatch" d="M30 236l-8 8M50 236l-8 8M70 236l-8 8M90 236l-8 8M110 236l-8 8M130 236l-8 8M150 236l-8 8M170 236l-8 8M190 236l-8 8M210 236l-8 8M230 236l-8 8M250 236l-8 8M270 236l-8 8M290 236l-8 8M310 236l-8 8M330 236l-8 8M350 236l-8 8M370 236l-8 8" />

  <!-- drone + tether + pod: drawn before the kiosk so the pod disappears into it -->
  <g class="dk-drone">
    <path class="dk-tether" d={`M${KX} 58V64`} />
    <g class="dk-pod">
      <rect class="part" x={KX - 13} y="60" width="26" height="22" rx="5" />
      <rect class="dk-parcel" x={KX - 8} y="65" width="16" height="12" rx="1.5" />
    </g>
    <g class="dk-body">
      <path class="part solid" d={`M${KX - 34} 46h68l-8 12h-52z`} />
      <path class="part-line" d={`M${KX - 60} 40H${KX + 60}`} />
      <ellipse class="dk-prop" cx={KX - 60} cy="36" rx="20" ry="3" />
      <ellipse class="dk-prop" cx={KX + 60} cy="36" rx="20" ry="3" />
      <path class="part-line" d={`M${KX - 60} 36V44M${KX + 60} 36V44`} />
    </g>
  </g>

  <g class="dk-kiosk">
    <rect class="part part-fill draw" pathLength="1" style="--t:.8s" x={KX - 52} y="104" width="104" height="132" rx="4" />
    <path class="part solid draw" pathLength="1" style="--d:.3s;--t:.5s" d={`M${KX - 60} 104H${KX - 18}V96H${KX + 18}V104H${KX + 60}V112H${KX - 60}Z`} />
    <rect class="part draw" pathLength="1" style="--d:.5s;--t:.4s" x={KX - 36} y="132" width="44" height="30" rx="3" />
    <rect class="part draw" pathLength="1" style="--d:.6s;--t:.4s" x={KX - 36} y="176" width="72" height="44" rx="3" />
    <path class="part-line fade" style="--d:.8s" d={`M${KX - 28} 198H${KX + 28}`} />
    <circle class="dk-light" cx={KX + 26} cy="140" r="4" />
    <text x={KX} y="252" class="t-mono t-small" text-anchor="middle">KIOSK</text>
  </g>

  <text x="296" y="92" class="t-hand fade" style="--d:1s">Droid / Pod</text>
  <path class="sk draw" pathLength="1" style="--d:1.1s;--t:.3s" d="M300 80C292 72 282 70 270 71" />

  {tally && (
    <g class="dk-tally">
      <text x="24" y="166" class="t-mono t-small">FLIGHT-TESTED PROTOTYPES</text>
      {Array.from({ length: 9 }, (_, i) => (
        <rect class="dk-tick pop" style={`--d:${1.2 + i * 0.12}s`} x={24 + i * 15} y="174" width="9" height="22" rx="1.5" />
      ))}
      <text x="24" y="214" class="t-mono t-small t-red">9 PROTOTYPES · 3 GENERATIONS</text>
    </g>
  )}
</svg>
