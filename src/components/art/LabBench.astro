---
// Cambrian Genomics: a liquid-handling gantry stepping along a well plate, filling each well.
interface Props { label?: string }
const { label = "Drawing of a liquid-handling robot: a pipette on a gantry steps along a row of wells and fills each one." } = Astro.props;
const wells = [0, 1, 2, 3, 4, 5, 6, 7].map((i) => 95 + i * 30);
---
<svg class="art lb" viewBox="0 0 400 280" width="400" height="280" role="img" aria-label={label}>
  <!-- deck and gantry -->
  <path class="ground" d="M24 244H376" />
  <path class="hatch" d="M30 244l-8 10M50 244l-8 10M70 244l-8 10M90 244l-8 10M110 244l-8 10M130 244l-8 10M150 244l-8 10M170 244l-8 10M190 244l-8 10M210 244l-8 10M230 244l-8 10M250 244l-8 10M270 244l-8 10M290 244l-8 10M310 244l-8 10M330 244l-8 10M350 244l-8 10M370 244l-8 10" />
  <rect class="part draw" pathLength="1" style="--t:.8s" x="40" y="40" width="12" height="204" />
  <rect class="part draw" pathLength="1" style="--d:.1s;--t:.8s" x="348" y="40" width="12" height="204" />
  <rect class="part draw" pathLength="1" style="--d:.3s;--t:.8s" x="40" y="34" width="320" height="14" />
  <path class="cl fade" style="--d:.6s" d="M56 41H344" />

  <!-- well plate (elevation) -->
  <rect class="part draw" pathLength="1" style="--d:.5s;--t:.8s" x="70" y="196" width="260" height="40" rx="3" />
  {wells.map((x, i) => (
    <>
      <path class="part-line draw" pathLength="1" style={`--d:${0.7 + i * 0.05}s;--t:.4s`} d={`M${x - 10} 199V220a10 10 0 0 0 20 0V199`} />
      <rect class="lb-liquid" style={`--i:${i}`} x={x - 8} y="212" width="16" height="16" rx="7" />
    </>
  ))}
  <text x="200" y="268" class="t-mono" text-anchor="middle">WELL PLATE · ELEVATION</text>

  <!-- carriage, pipette and tip -->
  <g class="lb-carriage">
    <rect class="part solid" x="77" y="48" width="36" height="18" rx="2" />
    <g class="lb-dip">
      <rect class="part" x="88" y="66" width="14" height="58" rx="2" />
      <path class="part" d="M88 124H102L97.5 172H92.5Z" />
      <path class="cl" d="M95 60V182" />
      <circle class="lb-drop" cx="95" cy="176" r="2.6" />
    </g>
  </g>
  <text x="300" y="28" class="t-hand fade" style="--d:1s">X travel →</text>
</svg>
