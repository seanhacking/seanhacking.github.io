---
// Veer's home-made universal testing machine: a log-splitter ram, a load cell, a belt specimen,
// and the load trace it draws.
interface Props { label?: string }
const { label = "Drawing of a home-made testing machine: a hydraulic ram from a log splitter pulls a belt sample against a load cell while a chart plots the load in cycles." } = Astro.props;

// Load trace: five cycles across the plot (x 214..380, baseline y 214, peak y 128).
const X0 = 216, X1 = 378, BASE = 210, PEAK = 132;
const cycles = 5;
let trace = `M${X0} ${BASE}`;
const w = (X1 - X0) / cycles;
for (let i = 0; i < cycles; i++) {
  const x = X0 + i * w;
  trace += `C${(x + w * 0.25).toFixed(1)} ${BASE} ${(x + w * 0.3).toFixed(1)} ${PEAK} ${(x + w * 0.5).toFixed(1)} ${PEAK}`;
  trace += `C${(x + w * 0.7).toFixed(1)} ${PEAK} ${(x + w * 0.75).toFixed(1)} ${BASE} ${(x + w).toFixed(1)} ${BASE}`;
}
---
<svg class="art tr" viewBox="0 0 400 280" width="400" height="280" role="img" aria-label={label}>
  <!-- frame -->
  <path class="ground" d="M20 250H190" />
  <rect class="part draw" pathLength="1" style="--t:.7s" x="40" y="34" width="12" height="204" />
  <rect class="part draw" pathLength="1" style="--d:.1s;--t:.7s" x="146" y="34" width="12" height="204" />
  <rect class="part solid draw" pathLength="1" style="--d:.25s;--t:.6s" x="32" y="26" width="134" height="16" rx="2" />
  <rect class="part draw" pathLength="1" style="--d:.35s;--t:.6s" x="32" y="236" width="134" height="14" rx="2" />

  <!-- load cell and upper grip -->
  <rect class="part tr-cell draw" pathLength="1" style="--d:.5s;--t:.4s" x="82" y="42" width="34" height="20" rx="3" />
  <text x="99" y="56" class="t-mono t-small" text-anchor="middle">LC</text>
  <rect class="part" x="90" y="62" width="18" height="16" />
  <circle class="pin" cx="99" cy="84" r="6" />

  <!-- belt specimen loop, stretched by the ram -->
  <g class="tr-spec">
    <rect class="tr-belt" x="91" y="80" width="16" height="96" rx="8" />
  </g>

  <!-- ram from the log splitter -->
  <g class="tr-ram">
    <circle class="pin" cx="99" cy="172" r="6" />
    <rect class="part" x="90" y="178" width="18" height="14" />
    <rect class="part" x="94" y="192" width="10" height="20" />
  </g>
  <rect class="part solid" x="74" y="208" width="50" height="28" rx="3" />
  <text x="99" y="226" class="t-mono t-small t-inv" text-anchor="middle">RAM</text>
  <text x="172" y="268" class="t-hand fade" style="--d:.8s" text-anchor="end">log splitter + load cell</text>

  <!-- chart -->
  <path class="axis draw" pathLength="1" style="--d:.6s;--t:.5s" d="M210 120V214H384" />
  <text x="206" y="114" class="t-mono t-small">LOAD</text>
  <text x="384" y="228" class="t-mono t-small" text-anchor="end">CYCLES</text>
  <path class="iso fade" style="--d:.9s" d="M210 160H384" />
  <text x="384" y="154" class="t-mono t-small t-cad" text-anchor="end">ISO</text>
  <path class="tr-trace" pathLength="1" d={trace} />
  <circle class="tr-dot" r="3.5" style={`offset-path: path('${trace}')`} />
  <text x="300" y="70" class="t-hand t-red fade" style="--d:1.2s" text-anchor="middle">beyond ISO</text>
  <path class="sk draw" pathLength="1" style="--d:1.3s;--t:.3s" d="M300 78C302 96 300 112 292 126" />
</svg>
