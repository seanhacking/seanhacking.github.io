---
import "../styles/global.css";
import profile from "../data/profile.json";
import { absoluteUrl, IS_PREVIEW, url } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article" | "profile";
  publishedTime?: Date;
  noindex?: boolean;
}

const { title, description = profile.headline, image, canonical, type = "website", publishedTime, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${profile.name}` : `${profile.name}: ${profile.headline}`;
const pageUrl = absoluteUrl(Astro.url.pathname);
const canonicalUrl = canonical ? absoluteUrl(canonical) : pageUrl;
const imageUrl = image ? absoluteUrl(image) : undefined;
const path = Astro.url.pathname;
const is404 = /\/404(?:\.html|\/)?$/.test(path);

const nav = [
  { href: url("/"), label: "Home", match: (p: string) => p === url("/") },
  { href: url("/about/"), label: "About", match: (p: string) => p.startsWith(url("/about/")) || p.startsWith(url("/cv/")) },
  { href: url("/projects/"), label: "Projects", match: (p: string) => p.startsWith(url("/projects/")) },
  { href: url("/blog/"), label: "Blog", match: (p: string) => p.startsWith(url("/blog/")) },
  { href: url("/contact/"), label: "Contact", match: (p: string) => p.startsWith(url("/contact/")) },
];
const normalisedPath = path.endsWith("/") ? path : path + "/";
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!is404 && <link rel="canonical" href={canonicalUrl} />}
    {(IS_PREVIEW || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141518" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name}: writing`} href={url("/rss.xml")} />
    {!IS_PREVIEW && <link rel="sitemap" href={url("/sitemap-index.xml")} />}

    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title ?? profile.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {!is404 && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content="en_US" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title ?? profile.name} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <script is:inline>
      // Theme: follow the system unless the visitor chose light or dark (stored only in their browser).
      (function () {
        var d = document.documentElement;
        d.classList.remove("no-js");
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") d.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap-wide">
        <a class="brand" href={url("/")}>{profile.name}</a>
        <nav class="nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li><a href={item.href} aria-current={item.match(normalisedPath) ? "page" : undefined}>{item.label}</a></li>
            ))}
          </ul>
          <button class="theme-toggle" type="button" aria-label="Switch colour theme">Theme</button>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap-wide">
        <span>&copy; {new Date().getFullYear()} {profile.name}{profile.location ? ` · ${profile.location}` : ""}</span>
        <ul>
          {profile.links.map((l) => <li><a href={l.url} rel="me noopener">{l.label}</a></li>)}
          <li><a href={url("/rss.xml")}>RSS</a></li>
        </ul>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var btn = document.querySelector(".theme-toggle");
        if (!btn) return;
        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        function current() { return d.getAttribute("data-theme") || (mq.matches ? "dark" : "light"); }
        function label() {
          var next = current() === "dark" ? "light" : "dark";
          btn.textContent = next === "dark" ? "Dark" : "Light";
          btn.setAttribute("aria-label", "Switch to " + next + " theme");
        }
        label();
        btn.addEventListener("click", function () {
          var next = current() === "dark" ? "light" : "dark";
          d.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
          label();
        });
        mq.addEventListener && mq.addEventListener("change", label);
      })();
    </script>
  </body>
</html>
