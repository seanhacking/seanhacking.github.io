---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
---
<Base title="Page not found" noindex>
  <div class="wrap page">
    <h1>Page not found</h1>
    <p class="lede">That page doesn't exist, or it moved.</p>
    <p><a href={url("/")}>Go to the home page</a> or <a href={url("/blog/")}>see the blog</a>.</p>
  </div>
</Base>
