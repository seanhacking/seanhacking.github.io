---
import Base from "../layouts/Base.astro";
import { url } from "../lib/url";
---
<Base title="Page not found" noindex>
  <div class="wrap-wide page">
    <header class="page-head">
      <p class="eyebrow">Error 404</p>
      <h1>This belt came off.</h1>
      <p class="lede">That page doesn't exist, or it moved.</p>
    </header>
    <ul class="button-row">
      <li><a class="button primary" href={url("/")}>Home page</a></li>
      <li><a class="button" href={url("/projects/")}>Projects</a></li>
      <li><a class="button" href={url("/blog/")}>Blog</a></li>
    </ul>
  </div>
</Base>
