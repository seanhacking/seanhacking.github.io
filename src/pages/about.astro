---
import Base from "../layouts/Base.astro";
import WorkingTogether from "../components/WorkingTogether.astro";
import ArtFrame from "../components/ArtFrame.astro";
import LabBench from "../components/art/LabBench.astro";
import profile from "../data/profile.json";
import { renderMarkdown } from "../lib/markdown";
import { url } from "../lib/url";

const [story] = profile.about.split(/\n##\s+Working together\s*\n/);
const about = renderMarkdown(story ?? profile.about);
const { cv } = profile;
const edu = cv.education[0];
const skill = (area: string) => cv.skills.find((s) => s.area === area)?.items ?? [];
const spec = [
  { k: "Discipline", v: "Mechanical engineering" },
  ...(profile.location ? [{ k: "Based", v: profile.location }] : []),
  ...(edu ? [{ k: "Studied", v: `${edu.degree}, ${edu.school.replace("University of California, ", "UC ")}` }] : []),
  { k: "CAD", v: skill("CAD and prototyping")[0] ?? "" },
  { k: "CNC", v: skill("CAD and prototyping")[1] ?? "" },
  { k: "Patents", v: skill("IP and safety")[0] ?? "" },
  { k: "Shop", v: skill("IP and safety")[1] ?? "" },
].filter((r) => r.v);
---
<Base title="About" description={`About ${profile.name}. ${profile.headline}`} type="profile">
  <div class="wrap-wide page">
    <header class="page-head">
      <p class="eyebrow">About</p>
      <h1>{profile.name}</h1>
      <p class="lede">{profile.headline}</p>
    </header>
    <div class="about-grid">
      <div>
        <div class="prose" set:html={about} />
        <ul class="button-row">
          <li><a class="button primary" href={url("/cv/")}>Read the CV</a></li>
          <li><a class="button" href={url("/projects/")}>See projects</a></li>
        </ul>
        <h2 class="eyebrow" style="margin-top:3rem">Career line</h2>
        <ol class="career">
          {cv.experience.map((job) => (
            <li>
              <span class="when">{job.start} – {job.end}</span>
              <strong>{job.org}</strong>
              <span class="what">{job.role}</span>
            </li>
          ))}
          {edu && (
            <li>
              <span class="when">Education</span>
              <strong>{edu.school.replace("University of California, ", "UC ")}</strong>
              <span class="what">{edu.degree}</span>
            </li>
          )}
        </ol>
      </div>
      <aside class="about-aside" aria-labelledby="spec-title">
        <h2 id="spec-title" class="eyebrow">Spec sheet</h2>
        <dl class="spec">
          {spec.map((r) => (<><dt>{r.k}</dt><dd>{r.v}</dd></>))}
        </dl>
        <ArtFrame title="Where it started: liquid handler" class="about-art"><LabBench /></ArtFrame>
      </aside>
    </div>
    <WorkingTogether />
  </div>
</Base>
