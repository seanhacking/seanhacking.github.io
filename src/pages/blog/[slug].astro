---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { formatDate, getPosts, slugify, type Post } from "../../lib/content";
import { url } from "../../lib/url";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const d = post.data;
---
<Base title={d.title} description={d.description} image={d.heroImage} canonical={d.canonical} type="article" publishedTime={d.date} noindex={d.draft === true}>
  <article class="wrap page">
    <p class="eyebrow"><a href={url("/blog/")}>Blog</a></p>
    {d.draft && <p class="draft-banner">Draft: not published on the live site.</p>}
    <h1>{d.title}</h1>
    <p class="meta"><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></p>
    {d.heroImage && <img class="hero-image" src={url(d.heroImage)} alt="" />}
    <div class="prose"><Content /></div>
    {d.tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {d.tags.map((t) => <li><a class="tag" href={url(`/blog/tags/${slugify(t)}/`)}>{t}</a></li>)}
      </ul>
    )}
    <hr />
    <p><a href={url("/blog/")}>All posts</a></p>
  </article>
</Base>
