---
import Base from "../layouts/Base.astro";
import profile from "../data/profile.json";

const { cv } = profile;
type Profile = typeof profile & { email?: string };
const email = (profile as Profile).email;
---
<Base title="CV" description={`CV of ${profile.name}: ${profile.headline}`}>
  <article class="wrap page">
    <header class="cv-header">
      <div>
        <h1>{profile.name}</h1>
        <p class="lede" style="margin:0">{profile.headline}</p>
      </div>
      <button class="button no-print" type="button" onclick="window.print()">Print or save as PDF</button>
    </header>
    <ul class="cv-contact" aria-label="Contact details">
      {profile.location && <li>{profile.location}</li>}
      {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
      {profile.links.map((l) => <li><a href={l.url}>{l.url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "")}</a></li>)}
    </ul>

    {cv.summary && (
      <section class="cv-section" aria-labelledby="cv-summary">
        <h2 id="cv-summary">Summary</h2>
        <p>{cv.summary}</p>
      </section>
    )}

    <section class="cv-section" aria-labelledby="cv-experience">
      <h2 id="cv-experience">Experience</h2>
      {cv.experience.map((job) => (
        <div class="cv-job">
          <div class="cv-job-head">
            <h3>{job.role}, {job.org}</h3>
            <span class="when">{job.start} – {job.end}</span>
          </div>
          <ul>{job.highlights.map((h) => <li>{h}</li>)}</ul>
        </div>
      ))}
    </section>

    <section class="cv-section" aria-labelledby="cv-skills">
      <h2 id="cv-skills">Skills</h2>
      <dl class="cv-skills">
        {cv.skills.map((s) => (
          <div>
            <dt>{s.area}</dt>
            <dd>{s.items.join("; ")}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="cv-section" aria-labelledby="cv-education">
      <h2 id="cv-education">Education</h2>
      {cv.education.map((e) => (
        <div class="cv-job">
          <div class="cv-job-head">
            <h3>{e.degree}</h3>
            <span class="when">{e.year}</span>
          </div>
          <p style="margin:0">{e.school}</p>
        </div>
      ))}
    </section>
  </article>
</Base>
